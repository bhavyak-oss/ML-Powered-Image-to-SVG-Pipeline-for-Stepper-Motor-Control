{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intermediate Document JSON Schema",
  "description": "Semantic JSON produced by Member 3's OCR pipeline and consumed directly by Member 4's review UI / SVG export.",
  "type": "object",
  "required": ["document_id", "page_dimensions_mm", "text_elements"],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique identifier, usually derived from the source filename."
    },
    "page_dimensions_mm": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "text_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "x_mm", "y_mm", "font_size_mm", "confidence", "bounding_box_pixel"],
        "properties": {
          "id": { "type": "string", "description": "e.g. txt_01" },
          "text": { "type": "string" },
          "x_mm": { "type": "number" },
          "y_mm": { "type": "number" },
          "font_size_mm": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bounding_box_pixel": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min, y_min, x_max, y_max] in source image pixel space"
          }
        }
      }
    }
  }
}
